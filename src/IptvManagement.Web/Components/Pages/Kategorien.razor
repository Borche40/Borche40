@page "/kategorien"
@inject IAdminDataService Admin
<h1>Kategorien</h1><button @onclick="()=>{form=new();editing=true;}">Neu anlegen</button>@if(message is not null){<div class="alert ok">@message</div>} @if(loading){<p class="loading">Kategorien werden geladen …</p>} else {<table><thead><tr><th>Name</th><th>Beschreibung</th><th>Sortierung</th><th>Status</th><th>Aktionen</th></tr></thead><tbody>@foreach(var x in items){<tr><td>@x.Name</td><td>@x.Description</td><td>@x.SortOrder</td><td>@(x.IsActive?"Aktiv":"Inaktiv")</td><td><button @onclick="()=>Edit(x)">Bearbeiten</button><button @onclick="()=>Deactivate(x.Id)">Deaktivieren</button></td></tr>}</tbody></table>}@if(editing){<section class="card"><EditForm Model="form" OnValidSubmit="Save"><DataAnnotationsValidator/><ValidationSummary/><input @bind="form.Name" placeholder="Name"/><input @bind="form.Description" placeholder="Beschreibung"/><input type="number" @bind="form.SortOrder"/><label><input type="checkbox" @bind="form.IsActive"/> Aktiv</label><button disabled="@saving">Speichern</button><button type="button" @onclick="()=>editing=false">Abbrechen</button></EditForm></section>}
@code{List<ChannelCategory> items=[]; CategoryFormModel form=new(); bool loading,editing,saving; string? message; protected override async Task OnInitializedAsync()=>await Load(); async Task Load(){loading=true;items=(await Admin.GetCategoriesAsync(default)).ToList();loading=false;} void Edit(ChannelCategory x){form=new(){Id=x.Id,Name=x.Name,Description=x.Description,SortOrder=x.SortOrder,IsActive=x.IsActive};editing=true;} async Task Save(){saving=true;await Admin.SaveCategoryAsync(form,default);saving=false;editing=false;message="Kategorie wurde gespeichert.";await Load();} async Task Deactivate(Guid id){await Admin.DeactivateCategoryAsync(id,default);message="Kategorie wurde deaktiviert.";await Load();}}
