@page "/kunden"
@rendermode InteractiveServer
@inject IAdminDataService Admin
<h1>Kunden</h1>
@if(!string.IsNullOrWhiteSpace(message)){<div class="alert ok">@message</div>} @if(!string.IsNullOrWhiteSpace(error)){<div class="alert err">@error</div>}
<div class="toolbar"><input @bind="search" @bind:event="oninput" placeholder="Name, Firma, Kundennummer oder E-Mail suchen"/><select @bind="filter"><option value="all">Alle</option><option value="active">Aktiv</option><option value="inactive">Inaktiv</option><option value="blocked">Blockiert</option></select><button @onclick="Load">Suchen</button><button @onclick="NewCustomer">Neu anlegen</button></div>
@if(loading){<p class="loading">Kunden werden geladen …</p>} else if(customers.Count==0){<div class="card">Keine Kunden gefunden.</div>} else {<table><thead><tr><th>Kundennummer</th><th>Name</th><th>Firma</th><th>E-Mail</th><th>Status</th><th>Aktionen</th></tr></thead><tbody>@foreach(var c in customers){<tr><td>@c.CustomerNumber</td><td>@c.FirstName @c.LastName</td><td>@c.CompanyName</td><td>@c.Email</td><td>@(c.IsBlocked?"Blockiert":c.IsActive?"Aktiv":"Inaktiv")</td><td><button @onclick="()=>Edit(c)">Bearbeiten</button><button @onclick="()=>Deactivate(c.Id)">Deaktivieren</button><button @onclick="()=>Block(c.Id,!c.IsBlocked)">@(c.IsBlocked?"Entsperren":"Blockieren")</button></td></tr>}</tbody></table>}
@if(editing){<section class="card"><h2>@(form.Id.HasValue?"Kunde bearbeiten":"Kunde neu anlegen")</h2><EditForm Model="form" OnValidSubmit="Save"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid"><input @bind="form.CustomerNumber" placeholder="Kundennummer"/><input @bind="form.FirstName" placeholder="Vorname"/><input @bind="form.LastName" placeholder="Nachname"/><input @bind="form.CompanyName" placeholder="Firmenname"/><input @bind="form.Email" placeholder="E-Mail"/><input @bind="form.Phone" placeholder="Telefon"/><input @bind="form.Address" placeholder="Adresse"/><input @bind="form.PostalCode" placeholder="Postleitzahl"/><input @bind="form.City" placeholder="Ort"/><input @bind="form.Country" placeholder="Land"/><textarea @bind="form.Notes" placeholder="Notizen"></textarea><label><input type="checkbox" @bind="form.IsActive"/> Aktiv</label><label><input type="checkbox" @bind="form.IsBlocked"/> Blockiert</label></div><button disabled="@saving" type="submit">@(saving?"Speichert …":"Speichern")</button><button type="button" @onclick="Cancel">Abbrechen</button></EditForm></section>}
@code{List<Customer> customers=[]; CustomerFormModel form=new(); string? search; string filter="all"; bool loading,editing,saving; string? message,error; protected override async Task OnInitializedAsync()=>await Load(); async Task Load(){loading=true; error=null; customers=(await Admin.GetCustomersAsync(search,filter,default)).ToList(); loading=false;} void NewCustomer(){form=new(); editing=true;} void Edit(Customer c){form=new(){Id=c.Id,CustomerNumber=c.CustomerNumber,FirstName=c.FirstName,LastName=c.LastName,CompanyName=c.CompanyName,Email=c.Email,Phone=c.Phone,Address=c.Address,PostalCode=c.PostalCode,City=c.City,Country=c.Country,Notes=c.Notes,IsActive=c.IsActive,IsBlocked=c.IsBlocked}; editing=true;} async Task Save(){if(string.IsNullOrWhiteSpace(form.CustomerNumber)||string.IsNullOrWhiteSpace(form.FirstName)||string.IsNullOrWhiteSpace(form.LastName)||string.IsNullOrWhiteSpace(form.Email)){error="Bitte füllen Sie alle Pflichtfelder aus.";return;} saving=true; await Admin.SaveCustomerAsync(form,null,default); saving=false; editing=false; message="Kunde wurde gespeichert."; await Load();} async Task Deactivate(Guid id){await Admin.DeactivateCustomerAsync(id,default); message="Kunde wurde deaktiviert."; await Load();} async Task Block(Guid id,bool blocked){await Admin.SetCustomerBlockedAsync(id,blocked,default); message=blocked?"Kunde wurde blockiert.":"Kunde wurde entsperrt."; await Load();} void Cancel()=>editing=false;}
