@page "/geraete"
@inject IAdminDataService Admin
<h1>Geräte</h1><button @onclick="New">Gerät registrieren</button>@if(message is not null){<div class="alert ok">@message</div>}<table><thead><tr><th>Name</th><th>Kunde</th><th>Typ</th><th>Letzter Zugriff</th><th>Status</th><th>Aktionen</th></tr></thead><tbody>@foreach(var x in items){<tr><td>@x.DeviceName</td><td>@x.Customer?.FirstName @x.Customer?.LastName</td><td>@x.DeviceType</td><td>@x.LastSeenAtUtc</td><td>@(x.IsBlocked?"Blockiert":x.IsActive?"Aktiv":"Inaktiv")</td><td><button @onclick="()=>Edit(x)">Bearbeiten</button><button @onclick="()=>Block(x.Id,!x.IsBlocked)">@(x.IsBlocked?"Entsperren":"Blockieren")</button><button @onclick="()=>Deactivate(x.Id)">Deaktivieren</button></td></tr>}</tbody></table>@if(editing){<section class="card"><EditForm Model="form" OnValidSubmit="Save"><select @bind="form.CustomerId">@foreach(var c in customers){<option value="@c.Id">@c.FirstName @c.LastName</option>}</select><select @bind="form.SubscriptionId">@foreach(var s in subs){<option value="@s.Id">@s.SubscriptionNumber</option>}</select><input @bind="form.DeviceName" placeholder="Gerätename"/><input @bind="form.DeviceIdentifier" placeholder="Gerätekennung"/><select @bind="form.DeviceType"><option value="@DeviceType.SmartTv">Smart TV</option><option value="@DeviceType.Mobile">Mobil</option><option value="@DeviceType.Browser">Browser</option></select><button>Speichern</button></EditForm></section>}
@code{List<Device> items=[];List<Customer> customers=[];List<Subscription> subs=[];DeviceFormModel form=new();bool editing;string? message;protected override async Task OnInitializedAsync()=>await Load();async Task Load(){items=(await Admin.GetDevicesAsync(default)).ToList();customers=(await Admin.GetCustomersAsync(null,"active",default)).ToList();subs=(await Admin.GetSubscriptionsAsync(default)).ToList();}void New(){form=new(){CustomerId=customers.FirstOrDefault()?.Id??Guid.Empty,SubscriptionId=subs.FirstOrDefault()?.Id??Guid.Empty};editing=true;}void Edit(Device d){form=new(){Id=d.Id,CustomerId=d.CustomerId,SubscriptionId=d.SubscriptionId,DeviceName=d.DeviceName,DeviceType=d.DeviceType,IsActive=d.IsActive,IsBlocked=d.IsBlocked};editing=true;}async Task Save(){await Admin.SaveDeviceAsync(form,default);editing=false;message="Gerät wurde gespeichert.";await Load();}async Task Block(Guid id,bool b){await Admin.SetDeviceBlockedAsync(id,b,default);await Load();}async Task Deactivate(Guid id){await Admin.DeactivateDeviceAsync(id,default);await Load();}}
