@page "/rechnungen"
@rendermode InteractiveServer
@inject IAdminDataService Admin
<h1>Rechnungen</h1><button @onclick="New">Rechnung erstellen</button>@if(message is not null){<div class="alert ok">@message</div>}<table><thead><tr><th>Nummer</th><th>Netto</th><th>USt</th><th>Brutto</th><th>Status</th><th>Aktionen</th></tr></thead><tbody>@foreach(var x in items){<tr><td>@x.InvoiceNumber</td><td>@x.NetAmount</td><td>@x.TaxAmount</td><td>@x.GrossAmount</td><td>@x.Status</td><td><button @onclick="()=>Paid(x.Id)">Als bezahlt markieren</button><a download="rechnung.txt" href="data:text/plain;charset=utf-8,Rechnung @x.InvoiceNumber">PDF herunterladen</a></td></tr>}</tbody></table>@if(editing){<section class="card"><EditForm Model="form" OnValidSubmit="Save"><select @bind="form.CustomerId">@foreach(var c in customers){<option value="@c.Id">@c.FirstName @c.LastName</option>}</select><select @bind="form.SubscriptionId">@foreach(var s in subs){<option value="@s.Id">@s.SubscriptionNumber</option>}</select><input type="number" @bind="form.NetAmount"/><button>Erstellen</button></EditForm></section>}
@code{List<Invoice> items=[];List<Customer> customers=[];List<Subscription> subs=[];InvoiceFormModel form=new();bool editing;string? message;protected override async Task OnInitializedAsync()=>await Load();async Task Load(){items=(await Admin.GetInvoicesAsync(default)).ToList();customers=(await Admin.GetCustomersAsync(null,"active",default)).ToList();subs=(await Admin.GetSubscriptionsAsync(default)).ToList();}void New(){form=new(){CustomerId=customers.FirstOrDefault()?.Id??Guid.Empty,SubscriptionId=subs.FirstOrDefault()?.Id??Guid.Empty};editing=true;}async Task Save(){await Admin.CreateInvoiceAsync(form,default);editing=false;message="Rechnung wurde erstellt.";await Load();}async Task Paid(Guid id){await Admin.MarkInvoicePaidAsync(id,default);message="Rechnung wurde als bezahlt markiert.";await Load();}}
