@page "/benutzer"
@inject IAdminDataService Admin
<h1>Benutzer</h1><button @onclick="New">Benutzer anlegen</button>@if(message is not null){<div class="alert ok">@message</div>}<table><thead><tr><th>Name</th><th>E-Mail</th><th>Rollen</th><th>Status</th><th>Aktionen</th></tr></thead><tbody>@foreach(var x in users){<tr><td>@x.FirstName @x.LastName</td><td>@x.Email</td><td>@x.Roles</td><td>@(x.IsActive?"Aktiv":"Inaktiv")</td><td><button @onclick="()=>Edit(x)">Bearbeiten</button><button @onclick="()=>Active(x.Id,!x.IsActive)">@(x.IsActive?"Deaktivieren":"Aktivieren")</button></td></tr>}</tbody></table>@if(editing){<section class="card"><EditForm Model="form" OnValidSubmit="Save"><input @bind="form.FirstName" placeholder="Vorname"/><input @bind="form.LastName" placeholder="Nachname"/><input @bind="form.Email" placeholder="E-Mail"/><input type="password" @bind="form.Password" placeholder="Passwort bei Neuanlage"/><select @bind="form.Role"><option>Administrator</option><option>Mitarbeiter</option><option>Reseller</option><option>NurLesen</option></select><label><input type="checkbox" @bind="form.IsActive"/> Aktiv</label><button>Speichern</button></EditForm></section>}
@code{List<UserListModel> users=[];UserFormModel form=new();bool editing;string? message;protected override async Task OnInitializedAsync()=>await Load();async Task Load()=>users=(await Admin.GetUsersAsync(default)).ToList();void New(){form=new(){IsActive=true,Role="NurLesen"};editing=true;}void Edit(UserListModel u){form=new(){Id=u.Id,FirstName=u.FirstName,LastName=u.LastName,Email=u.Email,Role=u.Roles.Split(',').FirstOrDefault()?.Trim()??"NurLesen",IsActive=u.IsActive};editing=true;}async Task Save(){await Admin.SaveUserAsync(form,default);editing=false;message="Benutzer wurde gespeichert.";await Load();}async Task Active(string id,bool a){await Admin.SetUserActiveAsync(id,a,default);await Load();}}
