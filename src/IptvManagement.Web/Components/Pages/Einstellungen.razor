@page "/einstellungen"
@inject IAdminDataService Admin
<h1>Einstellungen</h1><button @onclick="New">Neue Einstellung</button>@if(message is not null){<div class="alert ok">@message</div>}<table><thead><tr><th>Schlüssel</th><th>Wert</th><th>Beschreibung</th><th>Aktion</th></tr></thead><tbody>@foreach(var x in items){<tr><td>@x.Key</td><td>@x.Value</td><td>@x.Description</td><td><button @onclick="()=>Edit(x)">Bearbeiten</button></td></tr>}</tbody></table>@if(editing){<section class="card"><EditForm Model="form" OnValidSubmit="Save"><input @bind="form.Key" placeholder="Schlüssel"/><input @bind="form.Value" placeholder="Wert"/><input @bind="form.Description" placeholder="Beschreibung"/><button>Speichern</button></EditForm></section>}
@code{sealed class SettingForm{public Guid? Id{get;set;} public string Key{get;set;}=""; public string Value{get;set;}=""; public string? Description{get;set;}} List<SystemSetting> items=[];SettingForm form=new();bool editing;string? message;protected override async Task OnInitializedAsync()=>await Load();async Task Load()=>items=(await Admin.GetSettingsAsync(default)).ToList();void New(){form=new();editing=true;}void Edit(SystemSetting s){form=new(){Id=s.Id,Key=s.Key,Value=s.Value,Description=s.Description};editing=true;}async Task Save(){await Admin.SaveSettingAsync(form.Id,form.Key,form.Value,form.Description,default);editing=false;message="Einstellung wurde gespeichert.";await Load();}}
