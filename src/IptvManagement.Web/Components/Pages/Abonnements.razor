@page "/abonnements"
@rendermode InteractiveServer
@inject IAdminDataService Admin
<h1>Abonnements</h1><button @onclick="New">Neu anlegen</button>@if(message is not null){<div class="alert ok">@message</div>} @if(loading){<p class="loading">Abonnements werden geladen …</p>} else {<table><thead><tr><th>Nummer</th><th>Kunde</th><th>Paket</th><th>Ablauf</th><th>Status</th><th>Aktionen</th></tr></thead><tbody>@foreach(var x in items){<tr><td>@x.SubscriptionNumber</td><td>@x.Customer?.FirstName @x.Customer?.LastName</td><td>@x.Package?.Name</td><td>@x.ExpirationDateUtc.ToShortDateString()</td><td>@x.Status</td><td><button @onclick="()=>Edit(x)">Bearbeiten</button><button @onclick="()=>Status(x.Id,SubscriptionStatus.Active)">Aktivieren</button><button @onclick="()=>Status(x.Id,SubscriptionStatus.Paused)">Pausieren</button><button @onclick="()=>Status(x.Id,SubscriptionStatus.Blocked)">Sperren</button><button @onclick="()=>Status(x.Id,SubscriptionStatus.Cancelled)">Kündigen</button><button @onclick="()=>Renew(x.Id,12)">+12 Monate</button><button @onclick="()=>Token(x.Id)">Token erstellen</button><button @onclick="()=>Revoke(x.Id)">Token widerrufen</button></td></tr>}</tbody></table>}@if(editing){<section class="card"><EditForm Model="form" OnValidSubmit="Save"><DataAnnotationsValidator/><ValidationSummary/><select @bind="form.CustomerId">@foreach(var c in customers){<option value="@c.Id">@c.CustomerNumber - @c.FirstName @c.LastName</option>}</select><select @bind="form.PackageId">@foreach(var p in packages){<option value="@p.Id">@p.Name</option>}</select><input @bind="form.SubscriptionNumber" placeholder="Abonummer optional"/><InputDate @bind-Value="form.StartDateUtc"/><select @bind="form.DurationInMonths"><option value="1">1 Monat</option><option value="3">3 Monate</option><option value="6">6 Monate</option><option value="12">12 Monate</option></select><input type="number" @bind="form.MaxDevices"/><select @bind="form.Status"><option value="@SubscriptionStatus.Active">Aktiv</option><option value="@SubscriptionStatus.Paused">Pausiert</option><option value="@SubscriptionStatus.Blocked">Gesperrt</option></select><label><input type="checkbox" @bind="form.AutomaticRenewal"/> Automatische Verlängerung</label><button disabled="@saving">Speichern</button><button type="button" @onclick="()=>editing=false">Abbrechen</button></EditForm></section>}
@code{List<Subscription> items=[]; List<Customer> customers=[]; List<SubscriptionPackage> packages=[]; SubscriptionFormModel form=new(); bool loading,editing,saving; string? message; protected override async Task OnInitializedAsync()=>await Load(); async Task Load(){loading=true;items=(await Admin.GetSubscriptionsAsync(default)).ToList();customers=(await Admin.GetCustomersAsync(null,"active",default)).ToList();packages=(await Admin.GetPackagesAsync(default)).ToList();loading=false;} void New(){form=new(){CustomerId=customers.FirstOrDefault()?.Id??Guid.Empty,PackageId=packages.FirstOrDefault()?.Id??Guid.Empty};editing=true;} void Edit(Subscription x){form=new(){Id=x.Id,CustomerId=x.CustomerId,PackageId=x.PackageId,SubscriptionNumber=x.SubscriptionNumber,StartDateUtc=x.StartDateUtc,DurationInMonths=1,MaxDevices=x.MaxDevices,Status=x.Status,AutomaticRenewal=x.AutomaticRenewal};editing=true;} async Task Save(){saving=true;await Admin.SaveSubscriptionAsync(form,default);saving=false;editing=false;message="Abonnement wurde gespeichert.";await Load();} async Task Status(Guid id,SubscriptionStatus s){await Admin.SetSubscriptionStatusAsync(id,s,default);message="Status wurde geändert.";await Load();} async Task Renew(Guid id,int m){await Admin.RenewSubscriptionAsync(id,m,default);message="Abonnement wurde verlängert.";await Load();} async Task Token(Guid id){var t=await Admin.IssueTokenAsync(id,default);message=$"Token wurde erstellt: {t}";} async Task Revoke(Guid id){await Admin.RevokeTokenAsync(id,default);message="Token wurde widerrufen.";await Load();}}
