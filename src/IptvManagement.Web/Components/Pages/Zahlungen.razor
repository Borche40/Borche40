@page "/zahlungen"
@inject IAdminDataService Admin
<h1>Zahlungen</h1><button @onclick="New">Zahlung erfassen</button>@if(message is not null){<div class="alert ok">@message</div>}<table><thead><tr><th>Nummer</th><th>Betrag</th><th>Datum</th><th>Status</th><th>Referenz</th></tr></thead><tbody>@foreach(var x in items){<tr><td>@x.PaymentNumber</td><td>@x.Amount @x.Currency</td><td>@x.PaymentDateUtc.ToShortDateString()</td><td>@x.Status</td><td>@x.Reference</td></tr>}</tbody></table>@if(editing){<section class="card"><EditForm Model="form" OnValidSubmit="Save"><select @bind="form.CustomerId">@foreach(var c in customers){<option value="@c.Id">@c.FirstName @c.LastName</option>}</select><select @bind="form.SubscriptionId">@foreach(var s in subs){<option value="@s.Id">@s.SubscriptionNumber</option>}</select><input @bind="form.PaymentNumber" placeholder="Nummer optional"/><input type="number" @bind="form.Amount"/><input @bind="form.Currency"/><select @bind="form.PaymentMethod"><option value="@PaymentMethod.BankTransfer">Überweisung</option><option value="@PaymentMethod.Cash">Bar</option><option value="@PaymentMethod.Card">Karte</option></select><select @bind="form.Status"><option value="@PaymentStatus.Open">Offen</option><option value="@PaymentStatus.Paid">Bezahlt</option><option value="@PaymentStatus.Failed">Fehlgeschlagen</option></select><input @bind="form.Reference" placeholder="Referenz"/><textarea @bind="form.Notes" placeholder="Notiz"></textarea><button>Speichern</button></EditForm></section>}
@code{List<Payment> items=[];List<Customer> customers=[];List<Subscription> subs=[];PaymentFormModel form=new();bool editing;string? message;protected override async Task OnInitializedAsync()=>await Load();async Task Load(){items=(await Admin.GetPaymentsAsync(default)).ToList();customers=(await Admin.GetCustomersAsync(null,"active",default)).ToList();subs=(await Admin.GetSubscriptionsAsync(default)).ToList();}void New(){form=new(){CustomerId=customers.FirstOrDefault()?.Id??Guid.Empty,SubscriptionId=subs.FirstOrDefault()?.Id??Guid.Empty};editing=true;}async Task Save(){await Admin.SavePaymentAsync(form,default);editing=false;message="Zahlung wurde gespeichert.";await Load();}}
