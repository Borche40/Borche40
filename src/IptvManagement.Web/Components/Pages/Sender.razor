@page "/sender"
@inject IAdminDataService Admin
<h1>Sender</h1><button @onclick="New">Neu anlegen</button>@if(message is not null){<div class="alert ok">@message</div>} @if(loading){<p class="loading">Sender werden geladen …</p>} else {<table><thead><tr><th>Name</th><th>Kategorie</th><th>Land</th><th>Sprache</th><th>Lizenz</th><th>Status</th><th>Aktionen</th></tr></thead><tbody>@foreach(var x in channels){<tr><td>@x.Name</td><td>@x.Category?.Name</td><td>@x.CountryCode</td><td>@x.LanguageCode</td><td>@x.LicenseReference</td><td>@(x.IsActive?"Aktiv":"Inaktiv")</td><td><button @onclick="()=>Edit(x)">Bearbeiten</button><button @onclick="()=>Deactivate(x.Id)">Deaktivieren</button></td></tr>}</tbody></table>}@if(editing){<section class="card"><EditForm Model="form" OnValidSubmit="Save"><DataAnnotationsValidator/><ValidationSummary/><input @bind="form.Name" placeholder="Name"/><select @bind="form.CategoryId">@foreach(var c in categories){<option value="@c.Id">@c.Name</option>}</select><input @bind="form.StreamUrl" placeholder="Stream-URL wird verschlüsselt gespeichert"/><input @bind="form.LogoUrl" placeholder="Logo"/><input @bind="form.CountryCode"/><input @bind="form.LanguageCode"/><input type="number" @bind="form.SortOrder"/><input @bind="form.LicenseReference" placeholder="Lizenzreferenz"/><InputDate @bind-Value="form.LicenseValidUntilUtc"/><label><input type="checkbox" @bind="form.IsPubliclyAvailable"/> Öffentlich verfügbar</label><label><input type="checkbox" @bind="form.IsActive"/> Aktiv</label><button disabled="@saving">Speichern</button><button type="button" @onclick="Test">Stream testen</button><button type="button" @onclick="()=>editing=false">Abbrechen</button></EditForm></section>}
@code{List<Channel> channels=[]; List<ChannelCategory> categories=[]; ChannelFormModel form=new(); bool loading,editing,saving; string? message; protected override async Task OnInitializedAsync()=>await Load(); async Task Load(){loading=true;categories=(await Admin.GetCategoriesAsync(default)).ToList();channels=(await Admin.GetChannelsAsync(default)).ToList();loading=false;} void New(){form=new(){CategoryId=categories.FirstOrDefault()?.Id??Guid.Empty};editing=true;} void Edit(Channel x){form=new(){Id=x.Id,Name=x.Name,CategoryId=x.CategoryId,LogoUrl=x.LogoUrl,CountryCode=x.CountryCode,LanguageCode=x.LanguageCode,SortOrder=x.SortOrder,IsActive=x.IsActive,IsPubliclyAvailable=x.IsPubliclyAvailable,LicenseReference=x.LicenseReference,LicenseValidUntilUtc=x.LicenseValidUntilUtc};editing=true;} async Task Save(){saving=true;await Admin.SaveChannelAsync(form,default);saving=false;editing=false;message="Sender wurde gespeichert.";await Load();} async Task Deactivate(Guid id){await Admin.DeactivateChannelAsync(id,default);message="Sender wurde deaktiviert.";await Load();} async Task Test(){message=await Admin.TestStreamAsync(form.StreamUrl,default)?"Stream ist erreichbar.":"Stream ist nicht erreichbar.";}}
