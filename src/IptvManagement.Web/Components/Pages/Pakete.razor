@page "/pakete"
@rendermode InteractiveServer
@inject IAdminDataService Admin
<h1>Pakete</h1><button @onclick="New">Neu anlegen</button>@if(message is not null){<div class="alert ok">@message</div>} @if(loading){<p class="loading">Pakete werden geladen …</p>} else {<table><thead><tr><th>Name</th><th>Preis</th><th>Laufzeit</th><th>Geräte</th><th>Status</th><th>Aktionen</th></tr></thead><tbody>@foreach(var x in items){<tr><td>@x.Name</td><td>@x.Price @x.Currency</td><td>@x.DurationInMonths Monate</td><td>@x.MaxDevices</td><td>@(x.IsActive?"Aktiv":"Inaktiv")</td><td><button @onclick="()=>Edit(x)">Bearbeiten</button><button @onclick="()=>Deactivate(x.Id)">Deaktivieren</button></td></tr>}</tbody></table>}@if(editing){<section class="card"><EditForm Model="form" OnValidSubmit="Save"><DataAnnotationsValidator/><ValidationSummary/><input @bind="form.Name" placeholder="Name"/><input @bind="form.Description" placeholder="Beschreibung"/><input type="number" @bind="form.Price"/><input @bind="form.Currency"/><input type="number" @bind="form.DurationInMonths"/><input type="number" @bind="form.MaxDevices"/><label><input type="checkbox" @bind="form.IsActive"/> Aktiv</label><button disabled="@saving">Speichern</button><button type="button" @onclick="()=>editing=false">Abbrechen</button></EditForm></section>}
@code{List<SubscriptionPackage> items=[]; PackageFormModel form=new(); bool loading,editing,saving; string? message; protected override async Task OnInitializedAsync()=>await Load(); async Task Load(){loading=true;items=(await Admin.GetPackagesAsync(default)).ToList();loading=false;} void New(){form=new();editing=true;} void Edit(SubscriptionPackage x){form=new(){Id=x.Id,Name=x.Name,Description=x.Description,Price=x.Price,Currency=x.Currency,DurationInMonths=x.DurationInMonths,MaxDevices=x.MaxDevices,IsActive=x.IsActive};editing=true;} async Task Save(){saving=true;await Admin.SavePackageAsync(form,default);saving=false;editing=false;message="Paket wurde gespeichert.";await Load();} async Task Deactivate(Guid id){await Admin.DeactivatePackageAsync(id,default);message="Paket wurde deaktiviert.";await Load();}}
